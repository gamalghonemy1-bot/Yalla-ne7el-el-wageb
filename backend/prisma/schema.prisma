generator client { provider = "prisma-client-js" }
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { ADMIN TEACHER PARENT }
enum AssignmentStatus { PENDING IN_PROGRESS COMPLETED }

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  teacher      Teacher?
  parent       Parent?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Teacher {
  id          String             @id @default(uuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  classrooms  TeacherClassroom[]
  assignments Assignment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Parent {
  id        String                @id @default(uuid())
  userId    String                @unique
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  children  ChildParentRelation[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model Classroom {
  id          String             @id @default(uuid())
  name        String             @unique
  children    Child[]
  teachers    TeacherClassroom[]
  assignments Assignment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Child {
  id               String                @id @default(uuid())
  name             String
  birthDate        DateTime?
  classroomId      String
  classroom        Classroom             @relation(fields: [classroomId], references: [id])
  parents          ChildParentRelation[]
  childAssignments ChildAssignment[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  @@index([classroomId])
}

model ChildParentRelation {
  id        String   @id @default(uuid())
  childId   String
  parentId  String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([childId, parentId])
  @@index([parentId])
}

model TeacherClassroom {
  teacherId   String
  classroomId String
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@id([teacherId, classroomId])
}

model Question {
  id                  String               @id @default(uuid())
  text                String
  options             QuestionOption[]
  assignmentQuestions AssignmentQuestion[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([questionId])
}

model Assignment {
  id               String               @id @default(uuid())
  title            String
  classroomId      String
  classroom        Classroom            @relation(fields: [classroomId], references: [id])
  teacherId        String?
  teacher          Teacher?             @relation(fields: [teacherId], references: [id])
  dueDate          DateTime?
  questions        AssignmentQuestion[]
  childAssignments ChildAssignment[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  @@index([classroomId])
}

model AssignmentQuestion {
  id           String     @id @default(uuid())
  assignmentId String
  questionId   String
  order        Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  @@unique([assignmentId, questionId])
}

model ChildAssignment {
  id           String           @id @default(uuid())
  childId      String
  assignmentId String
  status       AssignmentStatus @default(IN_PROGRESS)
  score        Int              @default(0)
  correctCount Int              @default(0)
  wrongCount   Int              @default(0)
  completedAt  DateTime?
  child        Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  answers      ChildAnswer[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  @@unique([childId, assignmentId])
  @@index([assignmentId])
}

model ChildAnswer {
  id                String          @id @default(uuid())
  childAssignmentId String
  questionId        String
  optionId          String
  isCorrect         Boolean
  points            Int
  childAssignment   ChildAssignment @relation(fields: [childAssignmentId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  @@unique([childAssignmentId, questionId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
  @@index([userId])
}
